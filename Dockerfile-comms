FROM python:3.12-slim

# Accept build arguments
ARG GITHUB_TOKEN
ARG BRANCH_NAME=main

# Install system dependencies (git for private repo cloning)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Configure git to use GITHUB_TOKEN for private repo authentication
RUN git config --global url."https://${GITHUB_TOKEN}@github.com/".insteadOf "https://github.com/"

# Clone and install unillm + unifyai (private dependencies).
RUN DEP_BRANCH=$([ "$BRANCH_NAME" = "main" ] && echo "main" || echo "staging") && \
    git clone -b ${DEP_BRANCH} https://github.com/unifyai/unify.git /tmp/unify && \
    pip install --no-cache-dir /tmp/unify
RUN DEP_BRANCH=$([ "$BRANCH_NAME" = "main" ] && echo "main" || echo "staging") && \
    git clone -b ${DEP_BRANCH} https://github.com/unifyai/unillm.git /tmp/unillm && \
    pip install --no-cache-dir /tmp/unillm

# Pre-install URL-sourced spacy model so the subsequent unity install
# finds it already-satisfied. The model wheel is not on PyPI; unity's
# pyproject declares it via [tool.uv.sources] which only uv reads, so
# the pip-based install in this image needs the wheel already in
# site-packages for unity's dependency check to succeed.
RUN pip install --no-cache-dir \
    https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl

# Clone and install unity (Phase C.2). Provides the unity.gateway
# channels and the unity.gateway.app.create_app() factory that
# communication/main.py composes on top of in Phase C.3. unify and
# unillm are already installed above so unity's pyproject deps for
# them are already-satisfied. The image carries unity as a dormant
# dependency until C.3 wires it in.
RUN DEP_BRANCH=$([ "$BRANCH_NAME" = "main" ] && echo "main" || echo "staging") && \
    git clone -b ${DEP_BRANCH} https://github.com/unifyai/unity.git /tmp/unity && \
    pip install --no-cache-dir /tmp/unity

# Copy package metadata and source before install so the runtime package in
# site-packages matches the application code and bundled script assets.
COPY pyproject.toml README.md ./
COPY communication/ communication/
COPY common/ common/

# Install dependencies + the local communication package (including script assets).
RUN pip install --no-cache-dir ".[comms]"

EXPOSE 8080

CMD ["uvicorn", "communication.main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "2"]
