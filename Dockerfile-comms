FROM python:3.12-slim

# Accept build arguments
ARG GITHUB_TOKEN
ARG BRANCH_NAME=main

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    gnupg \
    lsb-release \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install necessary tools for key management (curl, gnupg)
# apt-get update and install should be in the same RUN command
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# Create the /etc/apt/keyrings directory if it doesn't exist
RUN mkdir -m 0755 -p /etc/apt/keyrings

# Download the Google Cloud GPG key, convert it, and store it
RUN curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg | gpg --dearmor -o /etc/apt/keyrings/cloud.google.gpg

# Add the Google Cloud CLI distribution URI as a package source
# Use the "signed-by" option to specify the GPG key file
RUN echo "deb [signed-by=/etc/apt/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" | tee -a /etc/apt/sources.list.d/google-cloud-sdk.list > /dev/null

# Update apt package index and install the gcloud CLI and GKE auth plugin
RUN apt-get update && apt-get install -y google-cloud-cli google-cloud-sdk-gke-gcloud-auth-plugin \
    && rm -rf /var/lib/apt/lists/*

# Configure GKE auth plugin path
ENV USE_GKE_GCLOUD_AUTH_PLUGIN=True

WORKDIR /app

# Configure git to use GITHUB_TOKEN for private repo authentication
RUN git config --global url."https://${GITHUB_TOKEN}@github.com/".insteadOf "https://github.com/"

# Clone and install unillm + unifyai (private dependencies, matching branch)
RUN git clone -b ${BRANCH_NAME} https://github.com/unifyai/unify.git /tmp/unify && \
    pip install --no-cache-dir /tmp/unify
RUN git clone -b ${BRANCH_NAME} https://github.com/unifyai/unillm.git /tmp/unillm && \
    pip install --no-cache-dir /tmp/unillm

# Copy pyproject.toml first for better caching
COPY pyproject.toml ./

# Install dependencies (comms extra includes unillm)
RUN pip install --no-cache-dir ".[comms]"

# Copy application code
COPY communication/ communication/
COPY common/ common/

EXPOSE 8080

CMD ["uvicorn", "communication.main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "2"]
