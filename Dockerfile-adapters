FROM python:3.12-slim

ARG GITHUB_TOKEN
ARG BRANCH_NAME=main
ARG UNITY_SHA=unknown

WORKDIR /app

COPY pyproject.toml README.md ./
COPY adapters/ adapters/
COPY common/ common/

RUN pip install --no-cache-dir ".[adapters]"

EXPOSE 8080

CMD ["uvicorn", "adapters.main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "2"]
