FROM python:3.11-slim

WORKDIR /app

# Copy package metadata and source before install so the runtime package in
# site-packages matches the application code.
COPY pyproject.toml README.md ./
COPY adapters/ adapters/
COPY common/ common/

# Install dependencies + the local adapters/common packages.
RUN pip install --no-cache-dir ".[adapters]"

EXPOSE 8080

# Run with uvicorn for production
# Using multiple workers for better concurrency handling
CMD ["uvicorn", "adapters.main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "2"]
