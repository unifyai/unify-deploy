FROM python:3.11-slim

WORKDIR /app

# Copy requirements first for better caching
COPY requirements-adapters.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY adapters/ adapters/

EXPOSE 8080

# Run with uvicorn for production
# Using multiple workers for better concurrency handling
CMD ["uvicorn", "adapters.main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "2"]
