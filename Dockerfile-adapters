FROM python:3.11-slim

WORKDIR /app

# Copy pyproject.toml first for better caching
COPY pyproject.toml ./

# Install dependencies (adapters optional group for lighter weight)
RUN pip install --no-cache-dir ".[adapters]"

# Copy application code
COPY adapters/ adapters/
COPY common/ common/

EXPOSE 8080

# Run with uvicorn for production
# Using multiple workers for better concurrency handling
CMD ["uvicorn", "adapters.main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "2"]
