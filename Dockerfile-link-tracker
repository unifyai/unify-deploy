FROM python:3.12-slim

ARG GITHUB_TOKEN
ARG BRANCH_NAME=main

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
RUN git config --global url."https://${GITHUB_TOKEN}@github.com/".insteadOf "https://github.com/"

# unisdk is the only Orchestra dependency this service needs; the redirect must
# stay small enough to start fast and simple enough to reason about.
RUN DEP_BRANCH=$([ "$BRANCH_NAME" = "main" ] && echo "main" || echo "staging") && \
    git clone -b ${DEP_BRANCH} https://github.com/unifyai/unisdk.git /tmp/unisdk && \
    pip install --no-cache-dir /tmp/unisdk

COPY pyproject.toml README.md ./
COPY link_tracker/ link_tracker/

RUN pip install --no-cache-dir ".[link-tracker]"

EXPOSE 8080

CMD ["uvicorn", "link_tracker.main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "2"]
