# Unity self-host compose environment.
# Generated by install-compose.sh — edit keys here, then run: unity restart

# --- Secrets (installer-generated on first run) ---
# POSTGRES_PASSWORD, ORCHESTRA_ADMIN_KEY, NEXTAUTH_SECRET, JWT_SECRET,
# INTEGRATION_CONFIRMATION_SECRET
NEXTAUTH_URL=http://127.0.0.1:3000

# --- Console ---
CONSOLE_PORT=3000

# --- BYOK (wizard prompts for these on install) ---
# Chat: at least one LLM key (OpenAI, Anthropic, or DeepSeek).
# OpenAI also powers tool-search embeddings when chat uses another provider.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Together AI key for OpenRouter BYOK (Together-pinned open-weight models).
TOGETHER_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Optional OpenAI organization Admin API key for usage/cost audits only.
# Do not use this key for model inference.
OPENAI_ADMIN_KEY=
# Voice (browser calls): LiveKit Cloud for media, Deepgram for STT, and
# Cartesia or ElevenLabs for TTS.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Required when phone/WhatsApp calls are enabled.
LIVEKIT_SIP_URI=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
# ElevenLabs is Twin's default speaking voice in production. Supply an API
# key and leave VOICE_PROVIDER/VOICE_ID at their defaults to use that voice,
# or switch both to a Cartesia voice if you prefer to stay all-Cartesia.
ELEVEN_API_KEY=
# Twin's TTS voice — must match a voice registered in the voices table.
# Defaults mirror the production coordinator voice (ElevenLabs "Friendly Flicker").
VOICE_PROVIDER=elevenlabs
VOICE_ID=iP95p4xoKVk53GoZ742B
# Chat model — the install wizard sets this to match your LLM key.
# Format: <model>@<provider>, e.g. claude-4.6-sonnet@anthropic
UNIFY_MODEL=

# --- Comms gateway ---
# Where Orchestra, Console, and the CM reach the comms/adapters layer. Defaults
# to the bundled local gateway (http://gateway:8001), which only exposes the
# channels you BYOK into it. Point this at a hosted (e.g. staging) comms
# deployment to light up its channels — phone/WhatsApp/SMS/Slack/Discord and the
# "Guess the reference" onboarding quiz — without running them locally. When set
# to a hosted URL, ORCHESTRA_ADMIN_KEY must match that deployment's admin key.
SELF_HOST_COMMS_URL=http://gateway:8001

# Internal shared Coordinator communications are opt-in because they use
# organization-owned Gmail/Twilio identities. The installer never enables
# either profile automatically.
SELF_HOST_INTERNAL_COMMS_ENABLED=false
SELF_HOST_INTERNAL_CALLS_ENABLED=false

# Provider-event triggers (opt-in). Requires a public HTTPS callback base and
# wrapping master key. Composio and/or Pipedream credentials are optional per
# backend; see deploy/selfhost/README.md. Unify does not provide a managed relay
# or tunnel for provider callbacks.
SELF_HOST_PROVIDER_TRIGGERS_ENABLED=false
ORCHESTRA_TRIGGER_CALLBACK_BASE_URL=
TRIGGER_EVENT_WRAPPING_MASTER_KEY=
COMPOSIO_WEBHOOK_SECRET=

# --- Optional ---
UNITY_WEB_TAVILY_API_KEY=
UNITY_WEB_ENABLED=false
ANTICAPTCHA_KEY=
UNITY_ACTOR_ANTICAPTCHA_KEY=
# Composio (https://composio.dev) — third-party app integrations (HubSpot,
# Notion, GitHub, ...). Leave empty to keep the Composio provider disabled.
COMPOSIO_API_KEY=
# Pipedream Connect (https://pipedream.com/connect) — fills gaps Composio does
# not cover. Requires client id/secret + project id from the Pipedream console.
# Use development locally; production Connect execution needs a paid plan.
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_PROJECT_ID=
PIPEDREAM_ENVIRONMENT=development

# --- Workspace bind mount (host path) ---
UNITY_WORKSPACE_HOST=${HOME}/Unity/Local

# --- Pub/Sub emulator ---
PUBSUB_GCP_PROJECT_ID=local-test-project
PUBSUB_TOPIC_SUFFIX=-staging

# --- Image tags (override for local builds) ---
UNITY_IMAGE=ghcr.io/unifyai/unity-selfhost:staging
CONSOLE_IMAGE=ghcr.io/unifyai/console-selfhost:staging
ORCHESTRA_IMAGE=ghcr.io/unifyai/orchestra:staging
DESKTOP_IMAGE=ghcr.io/unifyai/unity-desktop-selfhost:staging

# --- Desktop escape hatch: set to 0 and scale desktop services to 0 ---
UNITY_DESKTOP=1
