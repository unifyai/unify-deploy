# Adapters Environment Variables

# Orchestra
ORCHESTRA_ADMIN_KEY=

# Internal Service URLs
UNITY_COMMS_URL=
UNITY_ADAPTERS_URL=

# GCP
GCP_PROJECT_ID=
GCP_SA_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
ASSISTANT_MESSAGE_ATTACHMENTS_BUCKET_NAME=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Slack (Events API signing secret; app-level, shared across all
# workspace installs of the Slack app)
SLACK_SIGNING_SECRET=

# Microsoft Teams bot (Azure Bot / Entra app registration; app-level,
# shared across all org installs of the Teams app). APP_ID is the audience
# used to verify inbound Bot Framework JWTs; APP_SECRET mints outbound
# connector tokens.
MS_TEAMS_BOT_APP_ID=
MS_TEAMS_BOT_APP_SECRET=

# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_URI=
