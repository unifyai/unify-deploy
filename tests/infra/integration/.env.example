# Infrastructure Integration Test Configuration
#
# Copy this file to .env and fill in your credentials.
# The .env file is gitignored and will not be committed.
#
# The defaults target staging. Override TEST_COMMS_APP_URL, TEST_ADAPTERS_URL,
# TEST_NAMESPACE, and TEST_VM_ZONE to run against a different environment
# (e.g. staging or production).

# === Required: API Keys ===
# Your personal Unify API key (from console.unify.ai or your unity .env)
UNIFY_KEY=

# Admin key for the Comms App and Adapters (shared team key)
ORCHESTRA_ADMIN_KEY=

# Shared key for reading/writing AssistantJobs (shared team key)
SHARED_UNIFY_KEY=

# === Optional: Explicit GCP credentials for Pub/Sub checks ===
# The integration harness prefers these over ambient ADC when it needs to pull
# outbound Pub/Sub messages. Use one of these if your local ADC principal does
# not have `pubsub.subscriptions.consume` on gcp-project-runtime.
# TEST_GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/comm-sa.json
# TEST_GCP_SA_KEY={"type":"service_account",...}
#
# === Optional: Test Assistant ===
# The assistant ID to use for tests. If not set, the first assistant
# found for your UNIFY_KEY user is used automatically.
# TEST_ASSISTANT_ID=684

# === Optional: Override deployment target ===
# These default to the staging Cloud Run services. Override to test
# against staging, production, or a local environment.
# TEST_ORCHESTRA_URL=https://internal.example.com/v0
# TEST_COMMS_APP_URL=https://service.a.run.app
# TEST_ADAPTERS_URL=https://service.a.run.app
# TEST_NAMESPACE=staging
# TEST_VM_ZONE=us-central1-a
