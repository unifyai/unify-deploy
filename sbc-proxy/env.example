# SBC Proxy Configuration
# Copy this to .env and fill in your values

# Your SBC domain (must be verified in Microsoft 365)
SBC_DOMAIN=sbc.yourdomain.com

# LiveKit Configuration (from LiveKit Cloud dashboard)
LIVEKIT_SIP_URI=your-project.sip.livekit.cloud
LIVEKIT_SIP_PORT=5060
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Unity Adapters URL for webhook calls (called by Kamailio)
# Kamailio will call UNITY_ADAPTERS_URL/teams/call for incoming Teams calls
UNITY_ADAPTERS_URL=https://your-adapters-url.com

# GCP Configuration
GCP_PROJECT=your-gcp-project-id
GCP_ZONE=us-central1-a
GCP_VM_NAME=teams-sbc-proxy

# TLS Certificate paths (after running certbot)
TLS_CERT_PATH=/etc/letsencrypt/live/${SBC_DOMAIN}/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/${SBC_DOMAIN}/privkey.pem
