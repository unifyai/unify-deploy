# SBC Proxy Configuration
# Copy this to .env and fill in your values

# Your SBC domain (must be verified in Microsoft 365)
SBC_DOMAIN=sbc.unify.ai

# LiveKit SIP endpoint (from LiveKit Cloud dashboard)
LIVEKIT_SIP_URI=a1vhpufswgi.sip.livekit.cloud
LIVEKIT_SIP_PORT=5060

# GCP Configuration
GCP_PROJECT=gcp-project-runtime
GCP_ZONE=us-central1-f
GCP_VM_NAME=kamailio-sip-proxy

# TLS Certificate paths (after running certbot)
TLS_CERT_PATH=/etc/letsencrypt/live/${SBC_DOMAIN}/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/${SBC_DOMAIN}/privkey.pem
