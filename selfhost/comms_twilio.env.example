# Copy to ~/.droid/comms_twilio.env for local self-host SMS, WhatsApp text, and calls.
# Values are secrets and must never be committed.

# Main Twilio account for the localhost SMS/voice number.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WhatsApp sub-account for the localhost WhatsApp Sender.
TWILIO_WA_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WA_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
