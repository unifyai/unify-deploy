# Copy to ~/.droid/livekit_cloud.env for local self-host phone and WhatsApp calls.
# Values are secrets and must never be committed.
#
# Use a LiveKit Cloud project with SIP enabled. The local browser meet path can
# use local LiveKit, but Twilio call media needs LiveKit Cloud SIP.

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_SIP_URI=your-project.sip.livekit.cloud
