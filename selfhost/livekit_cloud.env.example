# Copy to ~/.unity/livekit_cloud.env for source-stack browser and phone calls.
# Values are secrets and must never be committed.
#
# Use one LiveKit Cloud project for browser Meet, Unity voice workers, SIP, and
# room APIs. Enable SIP when phone or WhatsApp calls are enabled.

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_SIP_URI=your-project.sip.livekit.cloud
