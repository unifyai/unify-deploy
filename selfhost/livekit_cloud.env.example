# Copy to ~/.unity/livekit_cloud.env for source-stack browser and phone calls.
# Values are secrets and must never be committed.
#
# Use one LiveKit Cloud project for browser Meet, Unity voice workers, SIP, and
# room APIs. Enable SIP when phone or WhatsApp calls are enabled.
#
# IMPORTANT: LIVEKIT_SIP_URI is NOT the same subdomain as LIVEKIT_URL and must
# not be derived from it. LiveKit Cloud assigns the SIP host its own subdomain
# (e.g. WSS host unity-qfe1fbvg.livekit.cloud but SIP host
# a1vhpufswgi.sip.livekit.cloud). Copy the exact "SIP URI" from the LiveKit
# Cloud dashboard (or the LIVEKIT_SIP_URI secret); guessing
# <wss-subdomain>.sip.livekit.cloud routes Twilio's INVITE to the wrong place
# and inbound SIP fails with a 404 (no audio on phone/WhatsApp calls).

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
# Exact SIP host from the LiveKit Cloud dashboard — usually a DIFFERENT
# subdomain than LIVEKIT_URL above (e.g. abcd1234.sip.livekit.cloud).
LIVEKIT_SIP_URI=your-sip-host.sip.livekit.cloud
